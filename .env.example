# 微信读书笔记洞察 - 环境变量配置

# 微信读书Cookie（必填）
# 从浏览器登录微信读书后，复制Cookie
WEREAD_COOKIE=

# Embedding API配置（SiliconFlow）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.com/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B

# LLM配置（OpenAI兼容接口，用于主题标签生成）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
